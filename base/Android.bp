package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "device_generic_vulkan-cereal_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    //   SPDX-license-identifier-BSD
    //   SPDX-license-identifier-GPL-2.0
    //   SPDX-license-identifier-MIT
    //   legacy_unencumbered
    default_applicable_licenses: ["device_generic_vulkan-cereal_license"],
}

genrule {
    name: "gfxstream_base_flat_byte_vector_mru_cache_header",
    tools: ["flatc"],
    cmd: "$(location flatc) --cpp --gen-object-api --scoped-enums --gen-mutable -o $(genDir) $(in)",
    srcs: ["FlatByteVectorMruCache.fbs"],
    out: ["FlatByteVectorMruCache_generated.h"],
}

cc_library_headers {
    name: "gfxstream_base_flat_byte_vector_mru_cache",
    host_supported: true,
    generated_headers: ["gfxstream_base_flat_byte_vector_mru_cache_header"],
    export_generated_headers: ["gfxstream_base_flat_byte_vector_mru_cache_header"],
    shared_libs: ["libflatbuffers-cpp"],
    export_shared_lib_headers: ["libflatbuffers-cpp"],
    vendor_available: true,
}

cc_library_static {
    name: "gfxstream_base",
    defaults: ["gfxstream_defaults"],
    header_libs: [
        "gfxstream_renderdoc_headers",
        "gfxstream_base_flat_byte_vector_mru_cache",
    ],
    srcs: [
        "AlignedBuf.cpp",
        "CompressingStream.cpp",
        "CpuTime.cpp",
        "DecompressingStream.cpp",
        "FileUtils.cpp",
        "FunctorThread.cpp",
        "GLObjectCounter.cpp",
        "HealthMonitor.cpp",
        "LayoutResolver.cpp",
        "MemStream.cpp",
	"MruCache.cpp",
        "StdioStream.cpp",
        "MemoryTracker.cpp",
        "MessageChannel.cpp",
        "Metrics.cpp",
        "PathUtils.cpp",
        "ring_buffer.cpp",
        "SharedLibrary.cpp",
        "SharedMemory_posix.cpp",
        "StringFormat.cpp",
        "Stream.cpp",
        "StreamSerializing.cpp",
        "SubAllocator.cpp",
        "System.cpp",
        "Tracing.cpp",
        "Thread_pthread.cpp",
    ],
    whole_static_libs: ["perfetto-tracing-only"],
    static_libs: ["gfxstream_lz4"],
    export_header_lib_headers: ["gfxstream_renderdoc_headers"]
}

// Run with `atest --host gfxstream_base_tests`
cc_test_host {
    name: "gfxstream_base_tests",
    defaults: [ "gfxstream_defaults" ],
    srcs: [
        "LruCache_unittest.cpp",
    ],
    static_libs: [
        "gfxstream_base",
        "libgmock",
        "libgtest",
        "libgtest_main",
    ],
    test_options: {
        unit_test: true,
    },
}
