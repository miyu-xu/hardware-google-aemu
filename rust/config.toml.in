zip = { path = "${AOSP_ROOT}/external/rust/crates/zip" }

#  The crates in this section are maintained by both the netsim and emulator team

# Why do we patch crates-io?
#  - To replace dev dependencies not needed for the actual build process.
#  - This can improve build performance and reduce unnecessary dependencies.
#  - We do not have to actually import the crates and maintain them
backtrace = { path = "${AOSP_ROOT}/hardware/google/aemu/rust/crates/backtrace" }
googletest = { path = "${AOSP_ROOT}/hardware/google/aemu/rust/crates/googletest" }
hermit-abi = { path = "${AOSP_ROOT}/hardware/google/aemu/rust/crates/hermit-abi" }
redox_syscall = { path = "${AOSP_ROOT}/hardware/google/aemu/rust/crates/redox_syscall" }
remove_dir_all = { path = "${AOSP_ROOT}/hardware/google/aemu/rust/crates/remove_dir_all" }
sha2 = { path = "${AOSP_ROOT}/hardware/google/aemu/rust/crates/sha2" }

# Windows-only crates for emulator functionality (sourced from AOSP QEMU).
# See: https://android.googlesource.com/platform/external/qemu/+/refs/heads/emu-master-dev/android/third_party/rust/crates
windows-sys = { path = "${AOSP_ROOT}/hardware/google/aemu/rust/crates/windows-sys-0.48.0" }
winapi = { path = "${AOSP_ROOT}/hardware/google/aemu/rust/crates/winapi-0.3.9" }
winapi-build = { path = "${AOSP_ROOT}/hardware/google/aemu/rust/crates/winapi-build-0.1.1" }
winapi-i686-pc-windows-gnu = { path = "${AOSP_ROOT}/hardware/google/aemu/rust/crates/winapi-i686-pc-windows-gnu-0.4.0" }
winapi-util = { path = "${AOSP_ROOT}/hardware/google/aemu/rust/crates/winapi-util-0.1.5" }
winapi-x86_64-pc-windows-gnu = { path = "${AOSP_ROOT}/hardware/google/aemu/rust/crates/winapi-x86_64-pc-windows-gnu-0.4.0" }
windows = { path = "${AOSP_ROOT}/hardware/google/aemu/rust/crates/windows-0.10.0" }
windows-sys = { path = "${AOSP_ROOT}/hardware/google/aemu/rust/crates/windows-sys-0.48.0" }
windows-targets = { path = "${AOSP_ROOT}/hardware/google/aemu/rust/crates/windows-targets-0.48.5" }
windows_aarch64_gnullvm = { path = "${AOSP_ROOT}/hardware/google/aemu/rust/crates/windows_aarch64_gnullvm-0.48.5" }
windows_aarch64_msvc = { path = "${AOSP_ROOT}/hardware/google/aemu/rust/crates/windows_aarch64_msvc-0.48.5" }
windows_gen = { path = "${AOSP_ROOT}/hardware/google/aemu/rust/crates/windows_gen-0.10.0" }
windows_i686_gnu = { path = "${AOSP_ROOT}/hardware/google/aemu/rust/crates/windows_i686_gnu-0.48.5" }
windows_i686_msvc = { path = "${AOSP_ROOT}/hardware/google/aemu/rust/crates/windows_i686_msvc-0.48.5" }
windows_macros = { path = "${AOSP_ROOT}/hardware/google/aemu/rust/crates/windows_macros-0.10.0" }
windows_x86_64_gnu = { path = "${AOSP_ROOT}/hardware/google/aemu/rust/crates/windows_x86_64_gnu-0.48.5" }
windows_x86_64_gnullvm = { path = "${AOSP_ROOT}/hardware/google/aemu/rust/crates/windows_x86_64_gnullvm-0.48.5" }
windows_x86_64_msvc = { path = "${AOSP_ROOT}/hardware/google/aemu/rust/crates/windows_x86_64_msvc-0.48.5" }
